{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/pair41\" hook session-start --agent claude-code"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "async": true,
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/pair41\" bridge"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/pair41\" hook user-prompt-submit --agent claude-code"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__.*pair__.*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/pair41\" hook pre-tool-use --agent claude-code"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/pair41\" hook post-tool-use --agent claude-code"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/pair41\" hook stop --agent claude-code"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/pair41\" wait --agent claude-code",
            "asyncRewake": true,
            "timeout": 29100
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/pair41\" hook session-end --agent claude-code"
          }
        ]
      }
    ]
  }
}
