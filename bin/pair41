#!/bin/sh
# The pair41 command: hooks, doctor, admin, migrate, serve, bridge, run.
# Node runs the TypeScript source directly (type stripping), so there is no build step.
SELF="$0"
while [ -h "$SELF" ]; do
  LINK="$(readlink "$SELF")"
  case "$LINK" in
    /*) SELF="$LINK" ;;
    *) SELF="$(dirname "$SELF")/$LINK" ;;
  esac
done
DIR="$(cd "$(dirname "$SELF")/.." && pwd -P)"
exec node --disable-warning=ExperimentalWarning "$DIR/src/cli/main.ts" "$@"
